local function getPlayerRole(player)
    local containers = {
        player.Character,
        player:FindFirstChild("Backpack"),
        player:FindFirstChild("StarterGear"),
    }

    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local lowerName = item.Name:lower()
                    if lowerName == "knife" or lowerName:find("knife") then
                        return "Murderer"
                    elseif lowerName == "gun" or lowerName:find("gun") or lowerName:find("revolver") then
                        return "Sheriff"
                    end
                end
            end
        end
    end

    return "Innocent"
end

local function getRoleColor(role)
    if role == "Murderer" then
        return Color3.fromRGB(248, 113, 113)
    elseif role == "Sheriff" then
        return Color3.fromRGB(96, 205, 255)
    end
    return Color3.fromRGB(74, 222, 128)
end

local function findDroppedGun()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name == "GunDrop" or obj.Name == "DroppedGun") then
            return obj
        elseif obj:IsA("Tool") and obj.Name == "Gun" and not obj:IsDescendantOf(Players) then
            local handle = obj:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                return handle
            end
        end
    end
    return nil
end

local function findNearestCoin(rootPos)
    local bestPart = nil
    local bestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n == "coin_server" or n == "coin" or n == "candy" or n:find("coin") or n:find("candy") then
                if obj.Transparency < 0.95 and obj.Parent then
                    local dist = (obj.Position - rootPos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPart = obj
                    end
                end
            end
        end
    end

    return bestPart, bestDist
end

local function updateRoleVisuals()
    if not Settings.RoleESP then
        for _, hl in pairs(roleHighlights) do
            if hl then hl:Destroy() end
        end
        table.clear(roleHighlights)
    end

    if not Settings.NameTags then
        for _, bb in pairs(roleBillboards) do
            if bb then bb:Destroy() end
        end
        table.clear(roleBillboards)
    end

    if not Settings.RoleESP and not Settings.NameTags then
        return
    end

    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local role = getPlayerRole(plr)
            local color = getRoleColor(role)
            local head = plr.Character:FindFirstChild("Head")
            local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")

            if Settings.RoleESP then
                local existing = roleHighlights[plr]
                if not existing or existing.Parent ~= plr.Character then
                    if existing then existing:Destroy() end
                    local hl = Instance.new("Highlight")
                    hl.Name = "MM2RoleESP"
                    hl.FillTransparency = 0.45
                    hl.OutlineTransparency = 0
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.Adornee = plr.Character
                    hl.Parent = plr.Character
                    roleHighlights[plr] = hl
                end
                roleHighlights[plr].FillColor = color
            end

            if Settings.NameTags and head then
                local existingBB = roleBillboards[plr]
                if not existingBB or existingBB.Parent ~= head then
                    if existingBB then existingBB:Destroy() end
                    local bb = Instance.new("BillboardGui")
                    bb.Name = "MM2RoleTag"
                    bb.Size = UDim2.fromOffset(165, 32)
                    bb.StudsOffset = Vector3.new(0, 2.4, 0)
                    bb.AlwaysOnTop = true
                    bb.Adornee = head
                    bb.Parent = head

                    local lbl = Instance.new("TextLabel")
                    lbl.Name = "Label"
                    lbl.Size = UDim2.fromScale(1, 1)
                    lbl.BackgroundTransparency = 1
                    lbl.Font = Enum.Font.GothamBold
                    lbl.TextSize = 11
                    lbl.TextStrokeTransparency = 0.35
                    lbl.Parent = bb

                    roleBillboards[plr] = bb
                end

                local distText = ""
                if myRoot and tRoot then
                    distText = string.format(" [%dm]", math.floor((tRoot.Position - myRoot.Position).Magnitude))
                end

                local pRank = getUserRank(plr)
                local rankPrefix = (pRank.Role == "Owner") and "[OWNER] " or ""

                local tagLabel = roleBillboards[plr]:FindFirstChild("Label")
                if tagLabel then
                    tagLabel.TextColor3 = (pRank.Role == "Owner") and pRank.Color or color
                    tagLabel.Text = string.format("%s%s (%s)%s", rankPrefix, plr.Name, role:sub(1, 3):upper(), distText)
                end
            end
        end
    end

    for plr, hl in pairs(roleHighlights) do
        if not plr.Parent or not plr.Character then
            if hl then hl:Destroy() end
            roleHighlights[plr] = nil
        end
    end

    for plr, bb in pairs(roleBillboards) do
        if not plr.Parent or not plr.Character then
            if bb then bb:Destroy() end
            roleBillboards[plr] = nil
        end
    end
end

local function updateGunESP()
    local gunPart = Settings.GunESP and findDroppedGun() or nil
    if not gunPart then
        if gunHighlight then
            gunHighlight:Destroy()
            gunHighlight = nil
        end
        return
    end

    if not gunHighlight or gunHighlight.Adornee ~= gunPart then
        if gunHighlight then gunHighlight:Destroy() end
        local hl = Instance.new("Highlight")
        hl.Name = "MM2GunESP"
        hl.FillColor = Color3.fromRGB(250, 204, 21)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.25
        hl.Adornee = gunPart
        hl.Parent = gunPart
        gunHighlight = hl
    end
end

local function grabDroppedGun()
    if grabbingGun then return false end
    local gunPart = findDroppedGun()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not gunPart or not root then return false end

    grabbingGun = true
    local oldCFrame = root.CFrame
    root.CFrame = gunPart.CFrame + Vector3.new(0, 1.5, 0)
    task.wait(0.14)
    if root and root.Parent then
        root.CFrame = oldCFrame
    end
    grabbingGun = false
    return true
end

local function teleportToPlayer(targetPlr)
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local tRoot = targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
    if myRoot and tRoot then
        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, 3.5)
        return true
    end
    return false
end

local function teleportToRole(targetRole)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and getPlayerRole(plr) == targetRole then
            if teleportToPlayer(plr) then
                return
            end
        end
    end
end

local function teleportToLobby()
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local spawnLoc = workspace:FindFirstChild("Lobby") and workspace.Lobby:FindFirstChildOfClass("SpawnLocation")
        or workspace:FindFirstChildOfClass("SpawnLocation")

    if spawnLoc then
        myRoot.CFrame = spawnLoc.CFrame + Vector3.new(0, 3, 0)
    elseif savedLobbyCFrame then
        myRoot.CFrame = savedLobbyCFrame
    end
end

local function spectatePlayer(targetPlr)
    if not targetPlr then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            Camera.CameraSubject = hum
        end
        return
    end

    local hum = targetPlr.Character and targetPlr.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        Camera.CameraSubject = hum
    end
end

local function spectateRole(targetRole)
    if not targetRole then
        spectatePlayer(nil)
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and getPlayerRole(plr) == targetRole then
            spectatePlayer(plr)
            return
        end
    end
end

local function flingTarget(targetPlr)
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    local tRoot = targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot or not myHum or not tRoot then return end

    local oldCFrame = myRoot.CFrame
    local bav = Instance.new("BodyAngularVelocity")
    bav.AngularVelocity = Vector3.new(0, 9999, 0)
    bav.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bav.P = math.huge
    bav.Parent = myRoot

    local startTime = os.clock()
    while (os.clock() - startTime) < 0.45 and tRoot.Parent and myRoot.Parent do
        myRoot.CFrame = tRoot.CFrame * CFrame.new(0, 0, -1.5)
        myRoot.AssemblyLinearVelocity = Vector3.new(180, 160, 180)
        RunService.Heartbeat:Wait()
    end

    bav:Destroy()
    if myRoot and myRoot.Parent then
        myRoot.AssemblyLinearVelocity = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
        myRoot.CFrame = oldCFrame
    end
end

local function setNoclip(enabled)
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end

    if enabled then
        noclipConn = RunService.Stepped:Connect(function()
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end

local function setInfJump(enabled)
    if infJumpConn then
        infJumpConn:Disconnect()
        infJumpConn = nil
    end

    if enabled then
        infJumpConn = UserInputService.JumpRequest:Connect(function()
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end)
    end
end

local function setFly(enabled)
    if flyBV then flyBV:Destroy(); flyBV = nil end
    if flyBG then flyBG:Destroy(); flyBG = nil end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if enabled then
        hum.PlatformStand = true
        flyBG = Instance.new("BodyGyro")
        flyBG.P = 9e4
        flyBG.MaxTorque = Vector3.new(9e4, 9e4, 9e4)
        flyBG.CFrame = root.CFrame
        flyBG.Parent = root

        flyBV = Instance.new("BodyVelocity")
        flyBV.MaxForce = Vector3.new(9e4, 9e4, 9e4)
        flyBV.Velocity = Vector3.zero
        flyBV.Parent = root
    else
        hum.PlatformStand = false
    end
end

