    setFly(false)
    setInfJump(false)
    spectatePlayer(nil)

    local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = 16
        hum.UseJumpPower = true
        hum.JumpPower = 50
    end
end

local function startCoinCollector()
    if coinLoopRunning then return end
    coinLoopRunning = true

    task.spawn(function()
        while Settings.CoinCollect do
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                local coinPart = findNearestCoin(root.Position)
                if coinPart and coinPart.Parent then
                    root.CFrame = coinPart.CFrame + Vector3.new(0, 1.2, 0)
                end
            end
            task.wait(Settings.CoinDelay)
        end
        coinLoopRunning = false
    end)
end

local function findPlayerByQuery(query)
    if not query or query == "" then return nil end
    local q = query:lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #q) == q or plr.DisplayName:lower():sub(1, #q) == q then
            return plr
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():find(q, 1, true) or plr.DisplayName:lower():find(q, 1, true) then
            return plr
        end
    end
    return nil
end

local adminFeedbackLabel = nil
local function setAdminFeedback(msg, isError)
    if adminFeedbackLabel then
        adminFeedbackLabel.Text = msg
        adminFeedbackLabel.TextColor3 = isError and Color3.fromRGB(248, 113, 113) or Theme.Accent
    end
end

local function runAdminCommand(rawText)
    local trimmed = rawText:match("^%s*(.-)%s*$")
    if not trimmed or trimmed == "" then
        setAdminFeedback("Enter a command (e.g., ;tp, ;speed 40, ;fly, ;reset)", true)
        return
    end

    if localRank.Level < 100 then
        setAdminFeedback("Insufficient rank: Owner required.", true)
        return
    end

    local clean = trimmed:gsub("^;", "")
    local parts = {}
    for token in clean:gmatch("%S+") do
        table.insert(parts, token)
    end

    local cmd = (parts[1] or ""):lower()
    local arg1 = parts[2]

    if cmd == "tp" or cmd == "goto" then
        local target = arg1 and findPlayerByQuery(arg1) or selectedTargetPlayer
        if target and teleportToPlayer(target) then
            setAdminFeedback("Teleported to " .. target.Name, false)
        else
            setAdminFeedback("Target not found or invalid.", true)
        end
    elseif cmd == "spectate" or cmd == "view" then
        local target = arg1 and findPlayerByQuery(arg1) or selectedTargetPlayer
        if target then
            spectatePlayer(target)
            setAdminFeedback("Spectating " .. target.Name, false)
        else
            setAdminFeedback("Select or type a target player.", true)
        end
    elseif cmd == "unspectate" or cmd == "unview" then
        spectatePlayer(nil)
        setAdminFeedback("Camera reset to self.", false)
    elseif cmd == "fling" then
        local target = arg1 and findPlayerByQuery(arg1) or selectedTargetPlayer
        if target then
            setAdminFeedback("Flinging " .. target.Name .. "...", false)
            task.spawn(function() flingTarget(target) end)
        else
            setAdminFeedback("Target not found.", true)
        end
    elseif cmd == "speed" or cmd == "ws" then
        local spd = tonumber(arg1) or 36
        Settings.WalkSpeed = spd
        Settings.SpeedBoost = true
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = spd end
        setAdminFeedback("WalkSpeed set to " .. tostring(spd), false)
    elseif cmd == "fly" then
        Settings.Fly = not Settings.Fly
        setFly(Settings.Fly)
        setAdminFeedback("Fly " .. (Settings.Fly and "enabled" or "disabled"), false)
    elseif cmd == "noclip" then
        Settings.Noclip = not Settings.Noclip
        setNoclip(Settings.Noclip)
        setAdminFeedback("Noclip " .. (Settings.Noclip and "enabled" or "disabled"), false)
    elseif cmd == "lobby" then
        teleportToLobby()
        setAdminFeedback("Teleported to lobby.", false)
    elseif cmd == "reset" or cmd == "clear" then
        resetAllStates()
        setAdminFeedback("All active states reset.", false)
    elseif cmd == "rejoin" then
        setAdminFeedback("Rejoining server...", false)
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
        end)
    else
        setAdminFeedback("Unknown command: " .. cmd, true)
    end
end

