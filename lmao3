-- Fluent Settings Card with Pill Switch
local function makeFluentSwitch(parent, titleText, descText, initialState, order, onToggle)
    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, 0, 0, 48)
    card.BackgroundColor3 = Theme.CardBg
    card.BorderSizePixel = 0
    card.LayoutOrder = order
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.Border
    stroke.Thickness = 1
    stroke.Parent = card

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -68, 0, 18)
    title.Position = UDim2.fromOffset(12, 7)
    title.BackgroundTransparency = 1
    title.Text = titleText
    title.TextColor3 = Theme.TextPrimary
    title.Font = Enum.Font.GothamMedium
    title.TextSize = 12
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = card

    local desc = Instance.new("TextLabel")
    desc.Size = UDim2.new(1, -68, 0, 15)
    desc.Position = UDim2.fromOffset(12, 25)
    desc.BackgroundTransparency = 1
    desc.Text = descText
    desc.TextColor3 = Theme.TextMuted
    desc.Font = Enum.Font.Gotham
    desc.TextSize = 10
    desc.TextXAlignment = Enum.TextXAlignment.Left
    desc.Parent = card

    local pill = Instance.new("TextButton")
    pill.Size = UDim2.fromOffset(40, 20)
    pill.Position = UDim2.new(1, -52, 0.5, -10)
    pill.BackgroundColor3 = initialState and Theme.Accent or Theme.SwitchOff
    pill.Text = ""
    pill.AutoButtonColor = false
    pill.Parent = card
    Instance.new("UICorner", pill).CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = initialState and UDim2.fromOffset(24, 4) or UDim2.fromOffset(4, 4)
    knob.BackgroundColor3 = initialState and Theme.TitleBarBg or Theme.KnobOff
    knob.BorderSizePixel = 0
    knob.Parent = pill
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = initialState
    local function setVal(newVal)
        state = newVal
        local info = TweenInfo.new(0.14, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        TweenService:Create(pill, info, {
            BackgroundColor3 = state and Theme.Accent or Theme.SwitchOff
        }):Play()
        TweenService:Create(knob, info, {
            Position = state and UDim2.fromOffset(24, 4) or UDim2.fromOffset(4, 4),
            BackgroundColor3 = state and Theme.TitleBarBg or Theme.KnobOff,
        }):Play()
        onToggle(state)
    end

    pill.MouseButton1Click:Connect(function() setVal(not state) end)
    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            setVal(not state)
        end
    end)
end

-- Fluent Action Button Card
local function makeFluentButton(parent, btnText, hintText, order, accentStyle, onClick)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.BackgroundColor3 = accentStyle and Theme.AccentDark or Theme.CardBg
    btn.TextColor3 = Theme.TextPrimary
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.Text = "   " .. btnText .. (hintText and ("  —  " .. hintText) or "")
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.LayoutOrder = order
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local stroke = Instance.new("UIStroke")
    stroke.Color = accentStyle and Theme.Accent or Theme.Border
    stroke.Thickness = 1
    stroke.Parent = btn

    local baseColor = accentStyle and Theme.AccentDark or Theme.CardBg
    local hoverColor = accentStyle and Color3.fromRGB(16, 132, 224) or Theme.CardHover

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = hoverColor }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.12), { BackgroundColor3 = baseColor }):Play()
    end)
    btn.MouseButton1Click:Connect(onClick)
end

