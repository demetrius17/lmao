local Pages = {}
local NavButtons = {}

local function switchTab(tabName, index)
    for name, page in pairs(Pages) do
        page.Visible = (name == tabName)
    end
    for name, btn in pairs(NavButtons) do
        local selected = (name == tabName)
        TweenService:Create(btn, TweenInfo.new(0.14), {
            BackgroundColor3 = selected and Theme.CardBg or Theme.NavBg,
            TextColor3 = selected and Theme.TextPrimary or Theme.TextSecondary,
        }):Play()
    end
    if index then
        local targetY = 8 + (index - 1) * 36 + 8
        TweenService:Create(NavIndicator, TweenInfo.new(0.18, Enum.EasingStyle.Quint), {
            Position = UDim2.fromOffset(2, targetY)
        }):Play()
    end
end

